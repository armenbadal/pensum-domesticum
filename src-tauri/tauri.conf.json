{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Տնային աշխատանք",
  "version": "0.2.0",
  "identifier": "armen.badalian.pensum-domesticum",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Տնային աշխատանք",
        "width": 800,
        "height": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdw"],
        "name": "Pensum Domesticum workbook",
        "description": "Տնային աշխատանքի տետր"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRTA0MUQ2NDk2RjMzNDEKUldSQk0yOUoxa0hnRXN3WXBiVUN4RU55YnFud3d0eDBiSWVma0R3bnY4VHBtZzZ2dDE3Mk5mUkMK",
      "endpoints": [
        "https://github.com/armenbadal/pensum-domesticum/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
