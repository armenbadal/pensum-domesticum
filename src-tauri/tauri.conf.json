{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Տնային աշխատանք",
  "version": "0.1.0",
  "identifier": "armen.badalian.pensum-domesticum",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Տնային աշխատանք",
        "width": 800,
        "height": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdw"],
        "name": "Pensum Domesticum workbook",
        "description": "Տնային աշխատանքի տետր"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
