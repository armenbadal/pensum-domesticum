{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "math-grid-state": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "version": {
              "const": 1
            },
            "cells": {
              "type": "string"
            },
            "borders": {
              "$ref": "#/$defs/math-grid-borders"
            }
          },
          "required": ["version", "cells", "borders"]
        },
        {
          "properties": {
            "version": {
              "const": 2
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "cells": {
              "type": "string"
            },
            "borders": {
              "$ref": "#/$defs/math-grid-borders"
            }
          },
          "required": ["version", "rows", "columns", "cells", "borders"]
        }
      ]
    },
    "math-grid-borders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "integer",
            "minimum": 0
          },
          "edge": {
            "enum": ["bottom", "left"]
          }
        },
        "required": ["cell", "edge"]
      }
    },
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["name", "email"]
    },
    "content-block": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text"
            },
            "content": {
              "type": "string"
            }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": {
              "const": "image"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": {
              "const": "squared"
            },
            "content": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                {
                  "$ref": "#/$defs/math-grid-state"
                }
              ]
            }
          },
          "required": ["type"]
        }
      ]
    },
    "content-blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/content-block"
      }
    }
  },
  "type": "object",
  "properties": {
    "solved": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "teacher": {
      "$ref": "#/$defs/person"
    },
    "student": {
      "$ref": "#/$defs/person"
    },
    "verified": {
      "type": "object",
      "properties": {
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": ["grade"]
    },
    "created-at": {
      "type": "string",
      "format": "date"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problem": {
            "$ref": "#/$defs/content-blocks"
          },
          "solution": {
            "$ref": "#/$defs/content-blocks"
          },
          "teacher-comment": {
            "type": "string"
          }
        },
        "required": ["problem", "solution"]
      }
    }
  },
  "required": ["title", "teacher", "created-at"]
}